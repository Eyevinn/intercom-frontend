# Example .env.local file
#
# These values configure local development (vite dev / vite build) at build
# time. In the Docker image the equivalent settings (MANAGER_URL -> backend
# URL, AUTH) are injected per deployment at container start via env.js and read
# from window.__ENV__ instead — see README "Docker Container".
VITE_BACKEND_URL=http://localhost:8000/
VITE_BACKEND_API_VERSION=api/v1/

VITE_DEBUG_MODE=true
VITE_DEV_LOGGER_LEVEL=3

# Optional ICE servers for the WebRTC peer connections, as a JSON array of
# RTCIceServer objects. When unset the app falls back to Google's public STUN
# servers. Override this (and/or supply a TURN server) to avoid leaking client
# IPs to a third party. In the Docker image set ICE_SERVERS instead; it is
# injected per deployment via env.js / window.__ENV__.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]

# Optional OSC login URL. When set, the app redirects here after a 401 from the
# manager persists through the in-app reauth flow, so the user can re-authenticate.
# AUTH=https://app.osaas.io/?redirect=/dashboard/service/eyevinn-intercom-manager
