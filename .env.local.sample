# Example .env.local file
VITE_BACKEND_URL=http://localhost:8000/
VITE_BACKEND_API_VERSION=api/v1/

VITE_DEBUG_MODE=true
VITE_DEV_LOGGER_LEVEL=3

# Keycloak / OIDC. Off unless VITE_OIDC_ENABLED is true, see docs/oidc.md.
VITE_OIDC_ENABLED=false
VITE_OIDC_AUTHORITY=https://keycloak.run.dmf.qvest-digital.com/realms/dmf
VITE_OIDC_CLIENT_ID=intercom
# Defaults to the browser origin; must match a redirect URI on the realm client.
#VITE_OIDC_REDIRECT_URI=http://localhost:5173
#VITE_OIDC_SCOPE=openid profile email
